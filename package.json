{
  "name": "fastsewa-training",
  "version": "3.0.0",
  "private": true,
  "main": "index.js",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n api,app -c blue,green \"npm run server:dev\" \"npm run expo:dev\"",
    "expo:dev": "expo start",
    "server:dev": "NODE_ENV=development tsx watch server/index.ts",
    "server:build": "node scripts/build-server.mjs",
    "server:start": "NODE_ENV=production node dist/index.js",
    "admin:build": "node scripts/build-admin.mjs",
    "build": "npm run server:build && npm run admin:build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "check:types": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p admin/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --import ./server/tests/setup.ts --test --test-concurrency=1 --test-reporter=spec \"server/tests/**/*.test.ts\" \"client/tests/**/*.test.ts\" \"admin/tests/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "test:unit": "node --import tsx --import ./server/tests/setup.ts --test --test-concurrency=1 --test-reporter=spec server/tests/config.test.ts server/tests/password.test.ts server/tests/tokens.test.ts server/tests/media-policy.test.ts server/tests/csv-and-errors.test.ts server/tests/certificate.test.ts server/tests/watch-time.test.ts server/tests/release-config.test.ts \"client/tests/**/*.test.ts\" \"admin/tests/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "check:release": "node scripts/check-release-config.mjs",
    "eas-build-pre-install": "node scripts/check-release-config.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "expo": "~54.0.32",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "i18next": "^24.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.4.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "chart.js": "^4.5.1",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
