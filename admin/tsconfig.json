{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [],
    "baseUrl": "..",
    "paths": { "@shared/*": ["shared/*"] }
  },
  "include": ["src/**/*", "tests/**/*", "../shared/constants.ts", "../shared/errors.ts", "../shared/validation.ts"]
}
